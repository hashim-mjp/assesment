# Copy to .env (gitignored) and fill in local values. Do not put real secrets here.

# Server
SERVER_PORT=8080

# Datasource (Spring profiles: local = file H2, postgres = PostgreSQL)
# Names match architecture.md — Spring Boot also binds SPRING_DATASOURCE_* automatically.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tickets
SPRING_DATASOURCE_USERNAME=tickets
SPRING_DATASOURCE_PASSWORD=change-me

# Optional: H2 file URL when using --spring.profiles.active=local
# SPRING_DATASOURCE_URL=jdbc:h2:file:./data/tickets
# SPRING_DATASOURCE_USERNAME=sa
# SPRING_DATASOURCE_PASSWORD=

# Frontend API base — prefer frontend/.env.example → frontend/.env.local
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
